rowser_type\": \"107.0\", \"windowWidth\": 1366, \"windowHight\": 615}, {\"rt\": null, \"stimulus\": \"<div style='font-size: 60px'>+</div>\", \"response\": null, \"screen_id\": \"fixation\", \"trial_type\": \"html-keyboard-response\", \"trial_index\": 329, \"time_elapsed\": 2599517, \"internal_node_id\": \"0.0-7.0-0.99\", \"subject_id\": \"S2_066\", \"ID_DATE\": \"S2_066\", \"browser_name\": \"Firefox\", \"browser_type\": \"107.0\", \"windowWidth\": 1366, \"windowHight\": 615}, {\"rt\": 751, \"response_type\": \"key\", \"key_press\": \"f\", \"response\": \"f\", \"avg_frame_time\": 17.113023255810923, \"center_x\": 337.79166666666663, \"center_y\": 302.05833333333334, \"screen_id\": \"task\", \"options\": [\"../../img/grid_stimuli/grid_6_modularity_8.jpg\", \"../../img/grid_stimuli/grid_6_modularity_36.jpg\"], \"trial_type\": \"psychophysics\", \"trial_index\": 330, \"time_elapsed\": 2600272, \"internal_node_id\": \"0.0-7.0-1.99\", \"subject_id\": \"S2_066\", \"ID_DATE\": \"S2_066\", \"browser_name\": \"Firefox\", \"browser_type\": \"107.0\", \"windowWidth\": 1366, \"windowHight\": 615}, {\"rt\": null, \"stimulus\": \"<div style='font-size: 60px'>+</div>\", \"response\": null, \"screen_id\": \"fixation\", \"trial_type\": \"html-keyboard-response\", \"trial_index\": 331, \"time_elapsed\": 2600977, \"internal_node_id\": \"0.0-8.0-0.0\", \"subject_id\": \"S2_066\", \"ID_DATE\": \"S2_066\", \"browser_name\": \"Firefox\", \"browser_type\": \"107.0\", \"windowWidth\": 1366, \"windowHight\": 615}, {\"rt\": 4724, \"stimulus\": \"<div> <font size=120%; font color = 'green';>Similarity task</font><br/>\\n                                       <br><br/>\\n             <font size = 6%> Now, you will make decisions about each group of foods.<br/>\\n             In the next task, you will be presented with a series of groups of foods. <br/>\\n             For each group, please rate how similarly liked the foods are. <br/>\\n             That is, if someone likes one of the foods, how likely is it that they also like the other foods?\\u000b <br><br/>\\n             <font color = 'red';>Note:</font> we are not asking whether you like or dislike the foods. Instead, we’re asking whether a random person would find the foods to be similarly appealing or not. <br/>\\n             To rate a group, use the mouse to click on the scale. Then press continue to proceed to the next round.<br><br/>\\n             <u>Take these ratings seriously, as they will be used to determine a bonus payment.</u>  <br>\\n             At the end of the study, we will randomly select a pair of these groups and compare your similarity ratings for them.  <br>\\n             If you correctly identify the more similarly liked group (based on prior participants’ liking ratings), then you will receive a fixed bonus payment of $2. <br>\\n             These rules ensure that it is in your best interest to provide truthful ratings. <br>\\n             Use the right end of the scale for the most similarly liked groups and the left end of the scale for the least similarly liked groups.<br/>\\n             <br><br/>\\n\\n             When you are ready, press the  <b>SPACEBAR</b> to start.</font>  </div>\", \"response\": \" \", \"trial_type\": \"html-keyboard-response\", \"trial_index\": 332, \"time_elapsed\": 2605703, \"internal_node_id\": \"0.0-8.0-1.0\", \"subject_id\": \"S2_066\", \"ID_DATE\": \"S2_066\", \"browser_name\": \"Firefox\", \"browser_type\": \"107.0\", \"windowWidth\": 1366, \"windowHight\": 615}, {\"rt\": 6124, \"stimulus\": \"../../img/grid_stimuli/grid_6_modularity_14.jpg\", \"slider_start\": 50, \"response\": 46, \"screen_id\": \"similarity\", \"trial_type\": \"image-slider-response\", \"trial_index\": 333, \"time_elapsed\": 2612372, \"internal_node_id\": \"0.0-8.0-2.0-0.0\", \"subject_id\": \"S2_066\", \"ID_DATE\": \"S2_066\", \"browser_name\": \"Firefox\", \"browser_type\": \"107.0\", \"windowWidth\": 1366, \"windowHight\": 615}, {\"rt\": 2468, \"stimulus\": \