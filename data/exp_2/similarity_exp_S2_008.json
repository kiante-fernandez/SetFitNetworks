e\": \"Firefox\", \"browser_type\": \"108.0\", \"windowWidth\": 1536, \"windowHight\": 739}, {\"rt\": null, \"stimulus\": \"<div style='font-size: 60px'>+</div>\", \"response\": null, \"screen_id\": \"fixation\", \"trial_type\": \"html-keyboard-response\", \"trial_index\": 331, \"time_elapsed\": 1034899, \"internal_node_id\": \"0.0-8.0-0.0\", \"subject_id\": \"S2_008\", \"ID_DATE\": \"S2_008\", \"browser_name\": \"Firefox\", \"browser_type\": \"108.0\", \"windowWidth\": 1536, \"windowHight\": 739}, {\"rt\": 55310, \"stimulus\": \"<div> <font size=120%; font color = 'green';>Similarity task</font><br/>\\n                                       <br><br/>\\n             <font size = 6%> Now, you will make decisions about each group of foods.<br/>\\n             In the next task, you will be presented with a series of groups of foods. <br/>\\n             For each group, please rate how similarly liked the foods are. <br/>\\n             That is, if someone likes one of the foods, how likely is it that they also like the other foods?\\u000b <br><br/>\\n             <font color = 'red';>Note:</font> we are not asking whether you like or dislike the foods. Instead, we’re asking whether a random person would find the foods to be similarly appealing or not. <br/>\\n             To rate a group, use the mouse to click on the scale. Then press continue to proceed to the next round.<br><br/>\\n             <u>Take these ratings seriously, as they will be used to determine a bonus payment.</u>  <br>\\n             At the end of the study, we will randomly select a pair of these groups and compare your similarity ratings for them.  <br>\\n             If you correctly identify the more similarly liked group (based on prior participants’ liking ratings), then you will receive a fixed bonus payment of $2. <br>\\n             These rules ensure that it is in your best interest to provide truthful ratings. <br>\\n             Use the right end of the scale for the most similarly liked groups and the left end of the scale for the least similarly liked groups.<br/>\\n             <br><br/>\\n\\n             When you are ready, press the  <b>SPACEBAR</b> to start.</font>  </div>\", \"response\": \" \", \"trial_type\": \"html-keyboard-response\", \"trial_index\": 332, \"time_elapsed\": 1090212, \"internal_node_id\": \"0.0-8.0-1.0\", \"subject_id\": \"S2_008\", \"ID_DATE\": \"S2_008\", \"browser_name\": \"Firefox\", \"browser_type\": \"108.0\", \"windowWidth\": 1536, \"windowHight\": 739}, {\"rt\": 17004, \"stimulus\": \"../../img/grid_stimuli/grid_6_modularity_72.jpg\", \"slider_start\": 50, \"response\": 81, \"screen_id\": \"similarity\", \"trial_type\": \"image-slider-response\", \"trial_index\": 333, \"time_elapsed\": 1107732, \"internal_node_id\": \"0.0-8.0-2.0-0.0\", \"subject_id\": \"S2_008\", \"ID_DATE\": \"S2_008\", \"browser_name\": \"Firefox\", \"browser_type\": \"108.0\", \"windowWidth\": 1536, \"windowHight\": 739}, {\"rt\": 16127, \"stimulus\": \"../../img/grid_stimuli/grid_6_modularity_6.jpg\", \"slider_start\": 50, \"response\": 54, \"screen_id\": \"similarity\", \"trial_type\": \"image-slider-response\", \"trial_index\": 334, \"time_elapsed\": 1123871, \"internal_node_id\": \"0.0-8.0-2.0-1.0\", \"subject_id\": \"S2_008\", \"ID_DATE\": \"S2_008\", \"browser_name\": \"Firefox\", \"browser_type\": \"108.0\", \"windowWidth\": 1536, \"windowHight\": 739}, {\"rt\": 7301, \"stimulus\": \"../../img/grid_stimuli/grid_6_modularity_90.jpg\", \"slider_start\": 50, \"response\": 66, \"screen_id\": \"similarity\", \"trial_type\": \"image-slider-response\", \"trial_index\": 335, \"time_elapsed\": 1131184, \"internal_node_id\": \"0.0-8.0-2.0-2.0\", \"subject_id\": \"S2_008\", \"ID_DATE\": \"S2_008\", \"browser_name\": \"Firefox\", \"browser_type\": \"108.0\", \"windowWidth\": 1536, \"windowHight\": 739}, {\"rt\": 12174, \"stimulus\": \"../../img/grid_stimuli/grid_6_modularity_30.jpg\", \"slider_start\": 50, \"response\": 56, \"screen_id\": \"simila